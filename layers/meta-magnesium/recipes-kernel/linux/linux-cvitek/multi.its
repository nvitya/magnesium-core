/dts-v1/;
/ {
	description = "Magnesium CV18xx Linux (no initramfs)";
	#address-cells = <1>;
	images {
		kernel {
			description = "Linux";
			data = /incbin/("Image.gz");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "gzip";
			load = <0x80200000>;
			entry = <0x80200000>;
			hash-1 { algo = "sha256"; };
		};
		fdt {
			description = "Magnesium headless board DTB";
			data = /incbin/("board.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash-1 { algo = "sha256"; };
		};
	};
	configurations {
		default = "config-1";
		config-1 {
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
